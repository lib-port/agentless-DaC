#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly PROJECT_ROOT
readonly STATE_FILE="${PROJECT_ROOT}/.vagrant/dac-vm.json"
readonly VAGRANT_VERSION="2.3.4"
readonly VAGRANT_LIBVIRT_VERSION="0.12.2"

usage() {
  printf 'Usage: scripts/vm-verify\n'
}

fail() {
  printf 'vm-verify: %s\n' "$*" >&2
  exit 1
}

(($# == 0)) || {
  usage >&2
  exit 2
}

for command_name in python3 vagrant; do
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required"
done
installed_vagrant_version="$(vagrant --version | awk 'NR == 1 {print $2}')"
[[ "$installed_vagrant_version" == "$VAGRANT_VERSION" ]] || \
  fail "Vagrant ${VAGRANT_VERSION} is required; found ${installed_vagrant_version:-unknown}"
installed_provider_version="$(
  vagrant plugin list | sed -n 's/^vagrant-libvirt (\([^,)]*\).*/\1/p'
)"
[[ "$installed_provider_version" == "$VAGRANT_LIBVIRT_VERSION" ]] || \
  fail "vagrant-libvirt ${VAGRANT_LIBVIRT_VERSION} is required; found ${installed_provider_version:-none}"
[[ -x "${SCRIPT_DIR}/vm-shell" ]] || fail "scripts/vm-shell is missing or not executable"
[[ -f "$STATE_FILE" && ! -L "$STATE_FILE" ]] || \
  fail "controller state is missing or unsafe; run scripts/vm-init first"

state_output="$(python3 - "$STATE_FILE" <<'PY'
import ipaddress
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
with path.open(encoding="utf-8") as handle:
    state = json.load(handle)

if set(state) != {"target_ip", "target_port", "host_key_fingerprint", "commit"}:
    raise SystemExit("controller state has unexpected or missing fields")
address = ipaddress.ip_address(state["target_ip"])
if address.version != 4 or address.is_multicast or address.is_unspecified:
    raise SystemExit("controller target is not a permitted IPv4 address")
port = state["target_port"]
if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
    raise SystemExit("controller target port is invalid")
fingerprint = state["host_key_fingerprint"]
if not isinstance(fingerprint, str) or not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{43}", fingerprint):
    raise SystemExit("controller host-key fingerprint is invalid")
commit = state["commit"]
if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
    raise SystemExit("controller commit is invalid")

print(commit)
print(address)
print(port)
print(fingerprint)
PY
)" || fail "controller state is invalid"
mapfile -t state_values <<<"$state_output"
((${#state_values[@]} == 4)) || fail "controller state could not be decoded"
readonly expected_commit=${state_values[0]}
readonly target_ip=${state_values[1]}
readonly target_port=${state_values[2]}
readonly target_fingerprint=${state_values[3]}

cd -- "$PROJECT_ROOT"
status_output="$(vagrant status controller --machine-readable)" || \
  fail "Vagrant could not read controller status"
grep -Eq ',controller,state,running$' <<<"$status_output" || \
  fail "controller is not running"

"${SCRIPT_DIR}/vm-shell" /bin/bash -s -- \
  "$expected_commit" "$target_ip" "$target_port" "$target_fingerprint" <<'GUEST_VERIFY'
set -euo pipefail

readonly expected_commit=$1
readonly expected_ip=$2
readonly expected_port=$3
readonly expected_fingerprint=$4

fail() {
  printf 'guest verification: %s\n' "$*" >&2
  exit 1
}

[[ "$(id -un)" == dac ]] || fail "controller shell is not running as dac"
[[ "$(cat /etc/detection-goggles/commit)" == "$expected_commit" ]] || \
  fail "deployed commit does not match controller state"

if findmnt --raw --noheadings \
  --types 9p,vboxsf,fuse.vmhgfs-fuse,virtiofs,nfs,nfs4 | grep -q .; then
  fail "a host-sharing filesystem is mounted"
fi
[[ -z "${SSH_AUTH_SOCK:-}" ]] || fail "an SSH agent was forwarded into the controller"

[[ "$(stat -c '%U:%G:%a' /opt/detection-goggles)" == "root:root:755" ]] || \
  fail "application root ownership or mode is unexpected"
[[ ! -w /opt/detection-goggles ]] || fail "application root is writable by dac"
for wrapper in /usr/local/bin/dacctl /usr/local/bin/dac-key-init /usr/local/bin/dac-export-report; do
  [[ "$(stat -c '%U:%G:%a' "$wrapper")" == "root:root:755" ]] || \
    fail "wrapper ownership or mode is unexpected: ${wrapper}"
  [[ ! -w "$wrapper" ]] || fail "wrapper is writable by dac: ${wrapper}"
done

for directory in \
  /var/lib/detection-goggles \
  /var/lib/detection-goggles/cache \
  /var/lib/detection-goggles/data \
  /var/lib/detection-goggles/evidence \
  /var/lib/detection-goggles/reports \
  /var/lib/detection-goggles/tmp; do
  [[ "$(stat -c '%U:%G:%a' "$directory")" == "dac:dac:700" ]] || \
    fail "runtime directory ownership or mode is unexpected: ${directory}"
done

[[ ! -e /tmp/dac-validation-venv ]] || fail "temporary validation environment remains"
for inventory in \
  /etc/detection-goggles/os-packages.txt \
  /etc/detection-goggles/python-packages.txt; do
  [[ -r "$inventory" && ! -L "$inventory" ]] || \
    fail "package inventory is missing or unsafe: ${inventory}"
done

python3 - \
  "$expected_ip" "$expected_port" "$expected_fingerprint" <<'PY'
import pathlib
import sys

expected = {
    "DAC_TARGET_IP": sys.argv[1],
    "DAC_TARGET_PORT": sys.argv[2],
    "DAC_TARGET_HOST_KEY": sys.argv[3],
}
actual = {}
for line in pathlib.Path("/etc/detection-goggles/controller.conf").read_text(
    encoding="utf-8"
).splitlines():
    key, separator, value = line.partition("=")
    if not separator or key in actual:
        raise SystemExit("controller configuration is malformed")
    actual[key] = value
if actual != expected:
    raise SystemExit("controller configuration does not match sealed state")
PY

systemctl is-active --quiet nftables || fail "nftables is not active"
if sudo -n /usr/bin/true >/dev/null 2>&1; then
  fail "dac unexpectedly has passwordless root access"
fi

dacctl --version
dacctl pack validate htb-malevolent-modmaker
/opt/detection-goggles/.venv/bin/ansible-playbook --version >/dev/null
/opt/detection-goggles/.venv/bin/ansible-playbook --syntax-check \
  -i 'dac_target,' /opt/detection-goggles/src/detection_goggles/ansible/fetch_files.yml \
  >/dev/null
GUEST_VERIFY

printf '%s\n' \
  "Controller verification passed for commit ${expected_commit}." \
  "Sealed SSH target: ${target_ip}:${target_port}"
