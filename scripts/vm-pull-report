#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly PROJECT_ROOT
readonly STATE_FILE="${PROJECT_ROOT}/.vagrant/dac-vm.json"
readonly MAX_REPORT_SIZE=$((10 * 1024 * 1024))

usage() {
  printf 'Usage: scripts/vm-pull-report RUN_ID [DESTINATION]\n'
}

fail() {
  printf 'vm-pull-report: %s\n' "$*" >&2
  exit 1
}

(($# == 1 || $# == 2)) || {
  usage >&2
  exit 2
}

run_id=$1
[[ "$run_id" =~ ^[A-Za-z0-9_-]{8,80}$ ]] || fail "invalid run ID"
[[ -f "$STATE_FILE" ]] || fail "controller state is missing; run scripts/vm-init first"

if (($# == 2)); then
  destination=$2
else
  destination="${PROJECT_ROOT}/reports/${run_id}"
fi
[[ -n "$destination" ]] || fail "destination must not be empty"
[[ ! -e "$destination" ]] || fail "destination already exists: $destination"

cd -- "$PROJECT_ROOT"
umask 077
ssh_config="$(mktemp "${PROJECT_ROOT}/.vagrant/dac-ssh.XXXXXX")"
destination_parent="$(dirname -- "$destination")"
destination_name="$(basename -- "$destination")"
mkdir -p -- "$destination_parent"
staging="$(mktemp -d "${destination_parent}/.${destination_name}.partial.XXXXXX")"
cleanup() {
  rm -f -- "$ssh_config"
  if [[ -d "$staging" ]]; then
    rm -rf -- "$staging"
  fi
}
trap cleanup EXIT

vagrant ssh-config controller >"$ssh_config"

for report_name in report.json report.md; do
  ssh -F "$ssh_config" \
    -o User=dac \
    -o ForwardAgent=no \
    -o ForwardX11=no \
    -o ClearAllForwardings=yes \
    -o PermitLocalCommand=no \
    -o RequestTTY=no \
    controller \
    "/usr/local/bin/dac-export-report '${run_id}' '${report_name}'" \
    >"${staging}/${report_name}" || \
    fail "missing or unsafe guest report: ${report_name}"
  [[ -f "${staging}/${report_name}" && ! -L "${staging}/${report_name}" ]] || \
    fail "exported ${report_name} is not a regular file"
  local_size="$(stat -c %s -- "${staging}/${report_name}")"
  ((local_size <= MAX_REPORT_SIZE)) || fail "exported ${report_name} exceeds the size limit"
  chmod 0600 "${staging}/${report_name}"
done

[[ ! -e "$destination" ]] || fail "destination appeared during export: $destination"
mv --no-clobber --no-target-directory -- "$staging" "$destination"
[[ ! -e "$staging" && -d "$destination" ]] || \
  fail "destination appeared during atomic publication: $destination"
printf 'Reports copied to %s\n' "$destination"
printf '%s\n' 'Treat exported reports as untrusted data; do not execute or automatically render them.'
