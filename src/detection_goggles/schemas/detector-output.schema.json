{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detection-goggles.dev/schemas/detector-output.schema.json",
  "title": "Detector subprocess output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "matches"],
  "properties": {
    "status": { "enum": ["detected", "not_detected", "unknown", "not_applicable"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "matches": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ids", "summary", "evidence"],
        "properties": {
          "subject_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^file-[0-9]{4,}$" }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "type", "value"],
              "properties": {
                "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
                "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$" },
                "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
              }
            }
          },
          "locations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id"],
              "properties": {
                "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
                "offset": { "type": "integer", "minimum": 0 },
                "length": { "type": "integer", "minimum": 1 },
                "line": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "detected" } } },
      "then": { "properties": { "matches": { "minItems": 1 } } },
      "else": { "properties": { "matches": { "maxItems": 0 } } }
    }
  ]
}

