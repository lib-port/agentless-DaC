{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detection-goggles.dev/schemas/finding.schema.json",
  "title": "Detection finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_id", "title", "severity", "confidence", "subjects", "summary", "evidence", "locations", "mitre_attack"],
  "properties": {
    "id": { "type": "string", "pattern": "^finding-[a-f0-9]{12}$" },
    "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "artifact_id"],
        "properties": {
          "kind": { "const": "file" },
          "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "type", "value"],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$" },
          "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "locations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id"],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
          "offset": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "mitre_attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tactics": { "type": "array", "items": { "type": "string" } },
        "techniques": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
