{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detection-goggles.dev/schemas/report.schema.json",
  "title": "Detection Goggles report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "pack", "summary", "artifacts", "acquisition_issues", "evaluations", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_run_id", "evaluated_at", "source", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$" },
        "evidence_run_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["local_files", "ssh"] },
        "mode": { "enum": ["acquisition", "replay"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "evaluation_count", "finding_count", "acquisition_issue_count", "statuses"],
      "properties": {
        "artifact_count": { "type": "integer", "minimum": 0 },
        "evaluation_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "acquisition_issue_count": { "type": "integer", "minimum": 0 },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detected": { "type": "integer", "minimum": 0 },
            "not_detected": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 },
            "not_applicable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/report_artifact" }
    },
    "acquisition_issues": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/issue" }
    },
    "evaluations": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "report_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_path", "size", "sha256", "media_type"],
      "properties": {
        "id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
        "kind": { "const": "file" },
        "display_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "size": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "message"],
      "properties": {
        "path": { "type": "string", "maxLength": 4096 },
        "code": { "enum": ["not_found", "permission_denied", "not_regular", "symlink_rejected", "directory_requires_recursive", "size_limit", "file_limit", "io_error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "status", "subject_ids", "finding_ids", "duration_ms"],
      "properties": {
        "id": { "type": "string", "pattern": "^eval-[a-f0-9]{12}$" },
        "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
        "status": { "enum": ["detected", "not_detected", "unknown", "error", "not_applicable"] },
        "subject_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^file-[0-9]{4,}$" } },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^finding-[a-f0-9]{12}$" } },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "type", "value"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$" },
        "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "title", "severity", "confidence", "subjects", "summary", "evidence", "locations", "mitre_attack"],
      "properties": {
        "id": { "type": "string", "pattern": "^finding-[a-f0-9]{12}$" },
        "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "artifact_id"],
            "properties": {
              "kind": { "const": "file" },
              "artifact_id": { "type": "string", "pattern": "^file-[0-9]{4,}$" }
            }
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/evidence_item" } },
        "locations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/location" } },
        "mitre_attack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tactics": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "techniques": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
